# Placeholders only. This repository does not load .env files automatically.

# The ONLY switch that selects the active text-response provider. Defaults to
# "openai" when unset. Set to "ollama" to use the local Ollama provider
# instead - nothing else in the code decides this.
AI_ROUTER_TEXT_PROVIDER=openai

OPENAI_API_KEY=replace-with-project-specific-api-key
AI_ROUTER_OPENAI_MODEL=replace-with-reviewed-openai-model-id
AI_ROUTER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
AI_ROUTER_CC_TOKEN=replace-with-at-least-32-random-characters
# R7 - Approval Source Hardening. Required to call
# POST /api/actions/:id/approval (decide a pending Jarvis action). Its own
# token, separate from AI_ROUTER_CC_TOKEN/AI_ROUTER_INTERNAL_TOKEN - same
# per-surface convention as the rest of this file. Unset or too short: every
# approval request is denied (APPROVAL_SOURCE_UNTRUSTED), not silently
# accepted - see docs/approval-source-hardening-r7.md.
AI_ROUTER_APPROVAL_TOKEN=replace-with-at-least-32-random-characters

# Only read when AI_ROUTER_TEXT_PROVIDER=ollama. No API key: Ollama runs
# locally, so there is no per-token price to configure.
AI_ROUTER_OLLAMA_MODEL=qwen2.5:7b-instruct
AI_ROUTER_OLLAMA_BASE_URL=http://localhost:11434
AI_ROUTER_OLLAMA_TIMEOUT_MS=60000

# Set both prices from the current official OpenAI model page before live use.
AI_ROUTER_OPENAI_INPUT_USD_PER_MILLION_TOKENS=replace-with-current-input-price
AI_ROUTER_OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=replace-with-current-output-price
AI_ROUTER_MAX_COST_USD=0.02

# Safe instance-local defaults shown explicitly for operations.
AI_ROUTER_PROVIDER_TIMEOUT_MS=15000
AI_ROUTER_MAX_REQUESTS_PER_MINUTE=10
AI_ROUTER_MAX_CONCURRENT_REQUESTS=2

# --- Local FELIX_SYSTEM knowledge index -----------------------------------
# Built by `npm run rag:reindex` (manual only) and read by POST
# /api/v1/cc/knowledge. NOT used by /api/router/respond or /api/v1/cc/summary.
# Separate embedding model, independent of AI_ROUTER_OLLAMA_MODEL above. No
# automatic pull: "ollama pull bge-m3" must be run manually before use.
# NOTE: Ollama normalizes an untagged pull to the explicit ":latest" tag
# (confirmed via GET /api/tags after a real pull) - the availability check
# does an exact string match, so the configured value must include the tag.
AI_ROUTER_OLLAMA_EMBEDDING_MODEL=bge-m3:latest
# Read-only. Must point at the local FELIX_SYSTEM vault checkout. Only the
# documents explicitly listed in config/rag-allowlist.json are ever opened -
# the vault is never scanned recursively.
AI_ROUTER_VAULT_ROOT=replace-with-absolute-path-to-FELIX_SYSTEM
# Optional override; defaults to config/rag-allowlist.json in this repo.
AI_ROUTER_RAG_ALLOWLIST_FILE=

# --- Jarvis voice v1: local speech-to-text (POST /api/jarvis/transcribe) --
# No default on purpose: unset means the route answers WHISPER_NOT_CONFIGURED
# cleanly instead of guessing a port. The AI-Router never starts, stops or
# otherwise manages this process - start whisper-server.exe yourself
# (whisper.cpp's server binary, --inference-path /inference) and point this
# at wherever it is actually listening. TEMPORARY: as of 2026-08-13 the
# verified local model in use is OpenWhispr's own
# ~/.cache/openwhispr/whisper-models/ggml-small.bin (used in place - not
# copied into this repo). That is a real external dependency on another
# app's installation; see README.md, "Jarvis v1: lokale Dialogoberfläche".
AI_ROUTER_WHISPER_SERVER_URL=

# --- Jarvis voice v1: local text-to-speech (POST /api/jarvis/speak) -------
# No defaults on either path, same reasoning as AI_ROUTER_WHISPER_SERVER_URL
# above: unset means the route answers PIPER_NOT_CONFIGURED cleanly instead
# of guessing a location. Unlike the STT step, this does NOT lean on an
# existing external app's install - Felix Core owns this file layout.
# Provisioned 2026-08-13 at .ai-router-data/tts/piper/piper.exe (both
# gitignored via .ai-router-data/) and the voice model below.
#
# DEPENDENCY CHOICE, DOCUMENTED DELIBERATELY: this points at the STANDALONE
# piper.exe from rhasspy/piper release 2023.11.14-2 (MIT license) - the last
# release before that project archived and its maintenance moved to
# OHF-Voice/piper1-gpl (GPL-3.0, Python-package-only, no standalone binary).
# Measured 2026-08-13 with the de_DE-thorsten-high voice: the 2023 standalone
# binary's cold start beats the 2026 Python package's by a clear, consistent
# margin at both a short test clip (1.15s vs 3.10s) and the same margin held
# with the high-quality voice (4.2s vs 6.6-7.0s), while using roughly 20-25%
# less RAM in both cases (thorsten-high: 239 MB vs ~307 MB) and requiring no
# Python runtime in this Node.js project at all. The real cost of this
# choice: the standalone binary is unmaintained since November 2023. If a
# maintained runtime becomes the priority over cold-start latency and the
# Python dependency, switch AI_ROUTER_PIPER_BINARY_PATH to a `piper` Python
# entry point (installed via `pip install piper-tts` / `uv pip install
# piper-tts`, OHF-Voice/piper1-gpl, GPL-3.0) - jarvis-speak-service.js's
# spawn arguments (-m, -f -, -q) are the same CLI shape either way.
AI_ROUTER_PIPER_BINARY_PATH=
# Voice model .onnx file; its .onnx.json config is expected alongside it
# with the same base name (piper's own default resolution - no separate
# variable for it). Chosen voice: de_DE-thorsten-high (rhasspy/piper-voices
# on Hugging Face, 108.6 MB) - selected over the faster de_DE-thorsten-medium
# and the lower-quality de_DE-kerstin-low (16kHz, and a defective phoneme
# mapping observed for combining cedilla, U+0327) after a real listening
# comparison on 2026-08-13.
AI_ROUTER_PIPER_VOICE_MODEL_PATH=
