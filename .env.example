# Placeholders only. This repository does not load .env files automatically.

# The ONLY switch that selects the active text-response provider. Defaults to
# "openai" when unset. Set to "ollama" to use the local Ollama provider
# instead - nothing else in the code decides this.
AI_ROUTER_TEXT_PROVIDER=openai

OPENAI_API_KEY=replace-with-project-specific-api-key
AI_ROUTER_OPENAI_MODEL=replace-with-reviewed-openai-model-id
AI_ROUTER_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
AI_ROUTER_CC_TOKEN=replace-with-at-least-32-random-characters

# Only read when AI_ROUTER_TEXT_PROVIDER=ollama. No API key: Ollama runs
# locally, so there is no per-token price to configure.
AI_ROUTER_OLLAMA_MODEL=qwen2.5:7b-instruct
AI_ROUTER_OLLAMA_BASE_URL=http://localhost:11434
AI_ROUTER_OLLAMA_TIMEOUT_MS=60000

# Set both prices from the current official OpenAI model page before live use.
AI_ROUTER_OPENAI_INPUT_USD_PER_MILLION_TOKENS=replace-with-current-input-price
AI_ROUTER_OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=replace-with-current-output-price
AI_ROUTER_MAX_COST_USD=0.02

# Safe instance-local defaults shown explicitly for operations.
AI_ROUTER_PROVIDER_TIMEOUT_MS=15000
AI_ROUTER_MAX_REQUESTS_PER_MINUTE=10
AI_ROUTER_MAX_CONCURRENT_REQUESTS=2

# --- Local FELIX_SYSTEM knowledge index (Commit B) -------------------------
# Not wired into any answer pipeline yet - only used by `npm run rag:reindex`.
# Separate embedding model, independent of AI_ROUTER_OLLAMA_MODEL above. No
# automatic pull: "ollama pull bge-m3" must be run manually before use.
# NOTE: Ollama normalizes an untagged pull to the explicit ":latest" tag
# (confirmed via GET /api/tags after a real pull) - the availability check
# does an exact string match, so the configured value must include the tag.
AI_ROUTER_OLLAMA_EMBEDDING_MODEL=bge-m3:latest
# Read-only. Must point at the local FELIX_SYSTEM vault checkout. Only the
# documents explicitly listed in config/rag-allowlist.json are ever opened -
# the vault is never scanned recursively.
AI_ROUTER_VAULT_ROOT=replace-with-absolute-path-to-FELIX_SYSTEM
# Optional override; defaults to config/rag-allowlist.json in this repo.
AI_ROUTER_RAG_ALLOWLIST_FILE=
