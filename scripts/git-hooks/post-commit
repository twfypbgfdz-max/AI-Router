#!/usr/bin/env bash
# post-commit — Warnhinweis bei Aenderungen an der Recommendation-Engine
#
# post-commit statt pre-push gewaehlt: die Erinnerung erscheint sofort beim
# Commit (nicht erst gesammelt beim naechsten Push) und kann, weil der Commit
# zu diesem Zeitpunkt bereits existiert, prinzipbedingt nie etwas blockieren.
#
# Nicht versioniert unter .git/hooks/ — Installation siehe README.md.

set -uo pipefail

WATCHED='^(orchestrator/recommendation-engine\.js|orchestrator/server\.js|docs/recommendation-engine-v1\.md)$'

CHANGED="$(git diff --name-only HEAD~1 HEAD 2>/dev/null)" || exit 0

if printf '%s\n' "$CHANGED" | grep -Eq "$WATCHED"; then
  cat >&2 <<'EOF'

Recommendation-Engine geaendert — Contract-Test im Command-Center-Repo sollte erneut laufen:
    node --test test/recommendation-contract.test.js
    (im Repo felix-command-center ausfuehren)

EOF
fi

exit 0
